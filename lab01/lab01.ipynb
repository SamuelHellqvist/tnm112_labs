        "import itertools\n",
        "import numpy as np\n",
        "import pandas as pd\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "from torch.utils.data import TensorDataset, DataLoader\n",
        "import torch_mlp\n",
        "import data_generator\n",
        "\n",
        "# Helper to build DataLoaders matching DataGenerator's one-hot encoded labels\n",
        "def make_loader(x, y_oh, batch_size, shuffle=True):\n",
        "    x_tensor = torch.tensor(x, dtype=torch.float32)\n",
        "    y_tensor = torch.tensor(y_oh, dtype=torch.float32)\n",
        "    return DataLoader(TensorDataset(x_tensor, y_tensor), batch_size=batch_size, shuffle=shuffle)\n",
        "\n",
        "# 1. Generate the exact dataset required for Task 1.3\n",
        "data_1_3 = data_generator.DataGenerator()\n",
        "data_1_3.generate(dataset='polar', N_train=512, N_test=512, K=5, sigma=0.05)\n",
        "\n",
        "# TorchMLP outputs Softmax probabilities and uses one-hot targets (y_*_oh) with MSELoss\n",
        "loss_fn = nn.MSELoss()\n",
        "\n",
        "# 2. Define hyperparameter search space\n",
        "param_grid = {\n",
        "    'init_std': [0.05, 0.1, 0.2],       # Stddev for normal weight initialization (mean=0.0)\n",
        "    'lr': [0.01, 0.05, 0.1],            # Learning rate for SGD\n",
        "    'momentum': [0.0, 0.9],             # SGD momentum\n",
        "    'gamma': [1.0, 0.95],               # ExponentialLR decay factor\n",
        "    'batch_size': [16, 64]              # Mini-batch size\n",
        "}\n",
        "\n",
        "epochs_search = 30\n",
        "results = []\n",
        "\n",
        "keys, values = zip(*param_grid.items())\n",
        "combinations = [dict(zip(keys, v)) for v in itertools.product(*values)]\n",
        "print(f\"\\nTesting {len(combinations)} hyperparameter combinations...\\n\")\n",
        "\n",
        "val_loader = make_loader(data_1_3.x_valid, data_1_3.y_valid_oh, batch_size=256, shuffle=False)\n",
        "test_loader = make_loader(data_1_3.x_test, data_1_3.y_test_oh, batch_size=256, shuffle=False)\n",
        "for params in combinations:\n",
        "    torch.manual_seed(42)\n",
        "    np.random.seed(42)\n",
        "    \n",
        "    train_loader = make_loader(data_1_3.x_train, data_1_3.y_train_oh, batch_size=params['batch_size'], shuffle=True)\n",
        "    \n",
        "    # Build 10 hidden layers of 50 neurons with ReLU\n",
        "    model = torch_mlp.TorchMLP(\n",
        "        K=5,\n",
        "        hidden_layers=10,\n",
        "        layer_width=50,\n",
        "        activation='relu',\n",
        "        verbose=False\n",
        "    )\n",
        "    \n",
        "    # Apply normal initialization with mean=0.0 and current init_std\n",
        "    for m in model.modules():\n",
        "        if isinstance(m, nn.Linear):\n",
        "            nn.init.normal_(m.weight, mean=0.0, std=params['init_std'])\n",
        "            nn.init.zeros_(m.bias)\n",
        "            \n",
        "    optimizer = torch.optim.SGD(model.parameters(), lr=params['lr'], momentum=params['momentum'])\n",
        "    scheduler = torch.optim.lr_scheduler.ExponentialLR(optimizer, gamma=params['gamma'])\n",
        "    \n",
        "    for epoch in range(epochs_search):\n",
        "        train_loss, train_acc = torch_mlp.train(train_loader, model, loss_fn, optimizer)\n",
        "        scheduler.step()\n",
        "            \n",
        "    val_loss, val_acc = torch_mlp.test(val_loader, model, loss_fn)\n",
        "    test_loss, test_acc = torch_mlp.test(test_loader, model, loss_fn)\n",
        "    \n",
        "    record = params.copy()\n",
        "    record['val_acc'] = val_acc\n",
        "    record['test_acc'] = test_acc\n",
        "    results.append(record)\n",
        "\n",
        "# 3. Display Best Combination (selected by validation accuracy, evaluated on test set)\n",
        "df_results = pd.DataFrame(results).sort_values(by=['val_acc', 'test_acc'], ascending=False)\n",
        "best_run = df_results.iloc[0]\n",
        "\n",
        "print(\"=\" * 60)\n",
        "print(\"BEST HYPERPARAMETER COMBINATION (Task 1.3)\")\n",
        "print(\"=\" * 60)\n",
        "for k in param_grid.keys():\n",
        "    print(f\"  {k:<12}: {best_run[k]}\")\n",
        "print(f\"  {'val_acc':<12}: {best_run['val_acc']:.4f}\")\n",
        "print(f\"  {'test_acc':<12}: {best_run['test_acc']:.4f}\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "print(\"\\nTop 5 Configurations:\")\n",
        "display(df_results.head(5))\n",
        "\n",
        "# 4. Measure Which Parameter Made the Most Difference\n",
        "print(\"\\n\" + \"=\" * 60)\n",
        "print(\"PARAMETER IMPACT ANALYSIS (Which parameter made the most difference?)\")\n",
        "print(\"=\" * 60)\n",
        "\n",
        "impact_rows = []\n",
        "impact_summary = []\n",
        "\n",
        "for param in param_grid.keys():\n",
        "    means = df_results.groupby(param)['test_acc'].mean()\n",
        "    max_diff = means.max() - means.min()\n",
        "    best_val = means.idxmax()\n",
        "\n",
        "    impact_summary.append({\n",
        "        'Parameter': param,\n",
        "        'Max Mean Acc Spread': max_diff,\n",
        "        'Best Average Value': best_val\n",
        "    })\n",
        "\n",
        "    for value, mean_acc in means.items():\n",
        "        impact_rows.append({\n",
        "            'Parameter': param,\n",
        "            'Value': value,\n",
        "            'Mean Test Accuracy': mean_acc\n",
        "        })\n",
        "\n",
        "df_impact = pd.DataFrame(impact_summary).sort_values(\n",
        "    by='Max Mean Acc Spread', ascending=False\n",
        ")\n",
        "df_parameter_values = pd.DataFrame(impact_rows)\n",
        "\n",
        "print(\"Parameter ranking:\")\n",
        "display(df_impact)\n",
        "\n",
        "print(\"\\nMean test accuracy for every parameter value:\")\n",
        "display(df_parameter_values)"
      ]
    }
  ],
