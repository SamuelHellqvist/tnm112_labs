      "source": [
        "# testinng mlp.py and the torch mlp\n",
        "import numpy as np\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "import mlp\n",
        "import torch_mlp\n",
        "\n",
        "# Shared model settings\n",
        "hidden_layers = 1\n",
        "layer_width = 5\n",
        "activation = \"relu\"\n",
        "init_std = 0.05\n",
        "\n",
        "# Generate one set of weights and biases to use in both models\n",
        "rng = np.random.default_rng(42)\n",
        "layer_sizes = [2] + [layer_width] * hidden_layers + [data.K]\n",
        "\n",
        "weights = [\n",
        "    rng.normal(0.0, init_std, (out_size, in_size)).astype(np.float32)\n",
        "    for in_size, out_size in zip(layer_sizes[:-1], layer_sizes[1:])\n",
        "]\n",
        "biases = [\n",
        "    np.zeros((size, 1), dtype=np.float32)\n",
        "    for size in layer_sizes[1:]\n",
        "]\n",
        "\n",
        "# Set up the NumPy MLP\n",
        "numpy_model = mlp.MLP(data)\n",
        "numpy_model.setup_model(weights, biases, activation=activation)\n",
        "\n",
        "# Set up the PyTorch MLP and copy in those exact same parameters\n",
        "torch_model = torch_mlp.TorchMLP(\n",
        "    K=data.K,\n",
        "    hidden_layers=hidden_layers,\n",
        "    layer_width=layer_width,\n",
        "    activation=activation,\n",
        "    verbose=False\n",
        ")\n",
        "\n",
        "linear_layers = [\n",
        "    layer for layer in torch_model.layers\n",
        "    if isinstance(layer, nn.Linear)\n",
        "]\n",
        "\n",
        "with torch.no_grad():\n",
        "    for layer, weight, bias in zip(linear_layers, weights, biases):\n",
        "        layer.weight.copy_(torch.from_numpy(weight))\n",
        "        layer.bias.copy_(torch.from_numpy(bias[:, 0]))\n",
        "\n",
        "# Compare predictions and metrics on the same test set\n",
        "numpy_probs = numpy_model.feedforward(data.x_test)\n",
        "torch_probs = torch_model.feedforward(data.x_test)\n",
        "\n",
        "max_diff = np.max(np.abs(numpy_probs - torch_probs))\n",
        "np.testing.assert_allclose(numpy_probs, torch_probs, rtol=1e-5, atol=1e-6)\n",
        "\n",
        "numpy_loss = np.mean((numpy_probs - data.y_test_oh) ** 2)\n",
        "torch_loss = np.mean((torch_probs - data.y_test_oh) ** 2)\n",
        "numpy_acc = np.mean(np.argmax(numpy_probs, axis=1) == data.y_test)\n",
        "torch_acc = np.mean(np.argmax(torch_probs, axis=1) == data.y_test)\n",
        "\n",
        "print(f\"Maximum prediction difference: {max_diff:.2e}\")\n",
        "print(f\"NumPy MLP — test loss: {numpy_loss:.6f}, accuracy: {numpy_acc:.4f}\")\n",
        "print(f\"PyTorch MLP — test loss: {torch_loss:.6f}, accuracy: {torch_acc:.4f}\")\n",
        "\n",
        " # Plot both classifiers on the same dataset\n",
        "print(\"PyTorch MLP\")\n",
        "data.plot_classifier(torch_model, G=64)\n",
        "\n",
        "print(\"NumPy MLP (same trained weights)\")\n",
        "data.plot_classifier(numpy_model, G=64)"
      ]
    },
