      "source": [
        "import torch_mlp\n",
        "\n",
        "# Train a model for a number of epochs. Returns a log of the loss and accuracy per epoch.\n",
        "# Understand what the different parameters mean and how they affect training.\n",
        "def fit(model, train_loader, val_loader, loss_fn, optimizer, scheduler=None, epochs=100):\n",
        "    log = {'loss': [], 'accuracy': [], 'val_loss': [], 'val_accuracy': []}\n",
        "\n",
        "    for epoch in range(epochs):\n",
        "        # One pass over the training data, updating the weights\n",
        "        loss, acc = torch_mlp.train(train_loader, model, loss_fn, optimizer)\n",
        "        # Measure performance on the validation data\n",
        "        val_loss, val_acc = torch_mlp.test(val_loader, model, loss_fn)\n",
        "\n",
        "        # Learning rate decay (if a scheduler is used), once per epoch.\n",
        "        # See the PyTorch scheduler docs: https://pytorch.org/docs/stable/optim.html#how-to-adjust-learning-rate\n",
        "        if scheduler is not None:\n",
        "            scheduler.step()\n",
        "\n",
        "        log['loss'].append(loss)\n",
        "        log['accuracy'].append(acc)\n",
        "        log['val_loss'].append(val_loss)\n",
        "        log['val_accuracy'].append(val_acc)\n",
        "        print(f'Epoch {epoch+1}/{epochs} - loss: {loss:.4f} - acc: {acc:.4f} - val_loss: {val_loss:.4f} - val_acc: {val_acc:.4f}')\n",
        "\n",
        "    return log\n"
      ]
    },
