        "import importlib\n",
        "import torch_mlp\n",
        "importlib.reload(torch_mlp)\n",
        "\n",
        "import torch\n",
        "import torch.nn as nn\n",
        "\n",
        "# Uncomment to be able to change data specification (instead of having to run the above cell every time)\n",
        "#data.generate(dataset='linear', N_train=512, N_test=512, K=2, sigma=0.1) # Task 1.1\n",
        "\n",
        "# Task 1.2: Polar dataset with 2 classes\n",
        "#data.generate(dataset='polar', N_train=512, N_test=512, K=2, sigma=0.1)  # Task 1.2\n",
        "\n",
        "# Task 1.3: Polar dataset with 5 classes\n",
        "data.generate(dataset='polar', N_train=512, N_test=512, K=5, sigma=0.05) # Task 1.3\n",
        "\n",
        "# Hyper-parameters\n",
        "hidden_layers = 10     # The number of hidden layers in the network (total number of layers will be L=hidden_layers+1)\n",
        "layer_width = 50       # The number of neurons in each hidden layer\n",
        "activation = 'relu' # Activation function of hidden layers\n",
        "init = lambda w: nn.init.normal_(w, mean=0.0, std=0.2) # Initialization method (starting point for the optimization)\n",
        "epochs = 20            # Number of epochs for the training\n",
        "batch_size = 16      # Batch size to use in training\n",
        "loss = nn.MSELoss()   # Loss function\n",
        "\n",
        "# The PyTorch MLP model, set up with the specified hyper parameters\n",
        "model_t = torch_mlp.TorchMLP(K=data.K, hidden_layers=hidden_layers, layer_width=layer_width,\n",
        "                             activation=activation, init=init, verbose=True)\n",
        "\n",
        "# Optimizer (needs the parameters of the model) and an otional learning rate scheduler\n",
        "opt = torch.optim.SGD(model_t.parameters(), lr=0.01, momentum=0.5)\n",
        "\n",
        "# Data loaders, which provide the data in batches\n",
        "train_loader = torch_mlp.make_loader(data.x_train, data.y_train_oh, batch_size, shuffle=True)\n",
        "val_loader = torch_mlp.make_loader(data.x_valid, data.y_valid_oh, batch_size)\n",
        "\n",
        "# Train the model a certain number of epochs with a specified batch size\n",
        "log = fit(model_t, train_loader, val_loader, loss, opt, epochs=epochs)\n",
        "\n",
        "# Plot the training progress\n",
        "torch_mlp.plot_training(log)\n",
        "\n",
        "# Evaluate the model (loss and accuracy on the training and test data)\n",
        "torch_mlp.evaluate(model_t, data, loss)\n",
        "\n",
        "# Plot the dataset with decision boundaries generated by the trained model\n",
        "data.plot_classifier(model_t)"
      ]
